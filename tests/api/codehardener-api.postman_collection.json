        {
          "name": "SQL Injection Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should not be vulnerable to SQL injection', function() {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "    var responseText = pm.response.text().toLowerCase();",
