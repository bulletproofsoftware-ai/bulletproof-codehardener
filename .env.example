# Code Hardener - Environment Configuration
# Copy this file to .env and customize values
#
# Quick start:
#   cp .env.example .env
#   docker compose up -d

# ===========================================
# DATABASE (Single Postgres, 3 databases)
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=codehardener
DB_PASSWORD=change-me-in-production-min-16
DB_NAME=codehardener

# Postgres container settings
POSTGRES_USER=codehardener
POSTGRES_PASSWORD=change-me-in-production-min-16
POSTGRES_DB=codehardener

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# BACKEND API
# ===========================================
NODE_ENV=development
BACKEND_PORT=4000
LOG_LEVEL=info

# ===========================================
# JWT Authentication
# ===========================================
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-string-min-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# INTERNAL API (n8n <-> backend communication)
# ===========================================
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=dev-internal-key-change-in-production

# ===========================================
# DefectDojo Integration
# ===========================================
DEFECTDOJO_ENABLED=true
DEFECTDOJO_URL=http://defectdojo:8080
DEFECTDOJO_PORT=8083
# API key is auto-generated by DefectDojo on first boot
# Retrieve via: docker exec codehardener-defectdojo python manage.py create_api_key admin
DEFECTDOJO_API_KEY=

# DefectDojo admin credentials (set on first boot)
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=defectdojo
DD_DATABASE_URL=postgresql://codehardener:change-me-in-production-min-16@postgres:5432/defectdojo
DD_SECRET_KEY=change-this-defectdojo-secret-key
DD_CREDENTIAL_AES_256_KEY=change-this-aes-key-exactly-128bits

# ===========================================
# n8n Workflow Automation
# ===========================================
N8N_ENABLED=true
N8N_URL=http://n8n:5678
N8N_PORT=5678
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
N8N_API_KEY=

# n8n container settings
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=codehardener
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n
N8N_DB_POSTGRESDB_USER=codehardener
N8N_DB_POSTGRESDB_PASSWORD=change-me-in-production-min-16
N8N_WEBHOOK_URL=http://localhost:5678

# ===========================================
# OAuth Providers (optional for development)
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# GitHub Integration
# ===========================================
# OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/oauth/callback

# Token encryption key - generate with: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# Webhook URL base
GITHUB_WEBHOOK_BASE_URL=https://your-domain.com/api/v1/github/webhooks/receive

# ===========================================
# Signing / Attestation (production)
# ===========================================
# SIGSTORE_ID_TOKEN=
# REKOR_URL=https://rekor.sigstore.dev

# ===========================================
# Email (optional)
# ===========================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# ===========================================
# URLs (production overrides)
# ===========================================
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_MARKETING_URL=https://yourdomain.com
# NEXT_PUBLIC_DASHBOARD_URL=https://app.yourdomain.com
