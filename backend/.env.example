# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://codehardener:codehardener_dev@localhost:5432/codehardener
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codehardener
DB_USER=codehardener
DB_PASSWORD=codehardener_dev

# Redis Configuration (for BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Scanner Configuration
SCANNER_TIMEOUT_MS=300000
SCANNER_MAX_CONCURRENT=5

# Sigstore (for attestations)
SIGSTORE_ENABLED=false
FULCIO_URL=https://fulcio.sigstore.dev
REKOR_URL=https://rekor.sigstore.dev

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_WEBHOOK_BASE_URL=

# DefectDojo Integration
DEFECTDOJO_URL=http://defectdojo:8080
DEFECTDOJO_API_KEY=
DEFECTDOJO_ENABLED=false

# n8n Integration
N8N_URL=http://n8n:5678
N8N_ENABLED=false
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
N8N_API_KEY=

# Internal API Key (for n8n -> backend communication)
INTERNAL_API_KEY=dev-internal-key-change-in-production

# Stripe Billing (optional - billing features disabled when not set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
